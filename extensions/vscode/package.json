{
  "name": "wildcat-code-agent-vscode",
  "displayName": "Wildcat Code Agent",
  "description": "Chat with the Wildcat Code Agent coding assistant (Ollama) in a VS Code panel.",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "publisher": "wildcat-code-agent",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "wildcatCodeAgent.openChat",
        "title": "Wildcat Code Agent: Open chat"
      },
      {
        "command": "wildcatCodeAgent.addSelection",
        "title": "Wildcat Code Agent: Add Selection to Chat"
      }
    ],
    "configuration": {
      "title": "Wildcat Code Agent",
      "properties": {
        "wildcatCodeAgent.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "wildcat-code-agent"
          ],
          "markdownDescription": "The command that starts the agent. `serve --stdio` and `--cwd <workspace folder>` are added. The default `wildcat-code-agent` must be on PATH. For development from the repo, use `[\"uv\", \"run\", \"--project\", \"C:\\path\\to\\wildcat-code-agent\", \"wildcat-code-agent\"]`. Reload the window after a change."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "wildcatCodeAgent.addSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "wildcatCodeAgent.addSelection",
        "key": "ctrl+alt+l",
        "when": "editorHasSelection"
      }
    ]
  },
  "scripts": {
    "copy-webview": "node scripts/copy-webview.mjs",
    "compile": "npm run copy-webview && tsc -p ./",
    "build": "npm run compile",
    "pretest": "npm run compile",
    "test": "node --test \"out/test/*.test.js\" \"test/*.test.mjs\"",
    "test:e2e": "npm run compile && node out/test-e2e/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/vscode": "~1.146.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "~5.9.3"
  }
}
